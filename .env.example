# Required for OpenAI-hosted models. For local OpenAI-compatible servers, any
# non-empty value is usually accepted.
OPENAI_API_KEY=

# Optional: OpenAI-compatible local or remote endpoint.
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1

# Optional: default model for the CLI.
# SALUKI_MODEL=gpt-5.4-mini

# Optional: JSON object passed to structured-output LLM calls.
# SALUKI_LLM_EXTRA_BODY={"reasoning_effort":"none"}

# Optional: web search providers.
# EXA_API_KEY=
# TAVILY_API_KEY=

# Optional: SonarQube scan settings used by scripts/sonar_scan.sh.
# SONAR_HOST_URL=http://localhost:9000
# SONAR_TOKEN=
# SONAR_PROJECT_KEY=saluki-idea-generation
# SONAR_PROJECT_NAME=saluki-idea-generation
# SONAR_SCANNER_HOST_URL=http://localhost:9000
# SONAR_QUALITYGATE_TIMEOUT=300

# Optional: keep uv cache out of the repo.
# UV_CACHE_DIR=/private/tmp/saluki-uv-cache
